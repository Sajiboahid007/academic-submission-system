{
  "name": "online-fds",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:online-FDS": "node dist/online-FDS/server/server.mjs",
    "fix-naming": "node scripts/enforce-naming.js"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "@angular/cdk": "21.1.3",
    "@angular/common": "21.2.5",
    "@angular/compiler": "21.2.5",
    "@angular/core": "21.2.5",
    "@angular/forms": "21.2.5",
    "@angular/material": "21.1.3",
    "@angular/platform-browser": "21.2.5",
    "@angular/platform-server": "21.2.5",
    "@angular/router": "21.2.5",
    "@angular/ssr": "21.2.5",
    "@primeuix/themes": "^2.0.3",
    "bootstrap": "^5.3.3",
    "express": "^5.1.0",
    "ngx-flexible-layout": "^21.0.1",
    "primeng": "^21.1.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.5",
    "@angular/cli": "21.2.5",
    "@angular/compiler-cli": "21.2.5",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "jsdom": "^27.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
